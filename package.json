{
  "name": "rocks.poopjournal.librelinkupdesktop",
  "version": "0.1.16",
  "author": {
    "name": "Yuran Fernando",
    "email": "yuran93@gmail.com"
  },
  "main": "./.erb/dll/main.bundle.dev.js",
  "scripts": {
    "prebuild": "node ./prebuild/index.mjs",
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:main": "cross-env NODE_ENV=production node --import tsx/cjs ./node_modules/webpack/bin/webpack.js --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production node --import tsx/cjs ./node_modules/webpack/bin/webpack.js --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "postinstall": "tsx .erb/scripts/check-native-dep.js && electron-builder install-app-deps && cross-env NODE_ENV=development node --import tsx/cjs ./node_modules/webpack/bin/webpack.js --config ./.erb/configs/webpack.config.renderer.dev.dll.ts",
    "lint": "cross-env NODE_ENV=development node --import tsx/cjs ./node_modules/eslint/bin/eslint.js .",
    "package": "tsx ./.erb/scripts/clean.js dist && npm run build && electron-builder build --publish never",
    "package-all": "tsx ./.erb/scripts/clean.js dist && npm run build && electron-builder build -mwl --publish never",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "start": "tsx ./.erb/scripts/check-port-in-use.js && npm run start:renderer",
    "start:main": "cross-env NODE_ENV=development node --import tsx/cjs ./node_modules/webpack/bin/webpack.js --config ./.erb/configs/webpack.config.main.dev.ts && electronmon .",
    "start:preload": "cross-env NODE_ENV=development node --import tsx/cjs ./node_modules/webpack/bin/webpack.js --config ./.erb/configs/webpack.config.preload.dev.ts",
    "start:renderer": "cross-env NODE_ENV=development node --import tsx/cjs ./node_modules/webpack/bin/webpack.js serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "test": "jest"
  },
  "browserslist": [],
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "release/app/node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy",
      "^@/(.*)$": "<rootDir>/src/renderer/$1"
    },
    "setupFiles": [
      "./.erb/scripts/check-build-exists.ts"
    ],
    "setupFilesAfterEnv": [
      "./.erb/scripts/jest.setup.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testPathIgnorePatterns": [
      "release/app/dist",
      ".erb/dll"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    }
  },
  "dependencies": {
    "@diakem/libre-link-up-api-client": "^0.7.2",
    "@hookform/resolvers": "^7.0.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "electron-debug": "^5.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.12",
    "framer-motion": "^14.9.1",
    "i18next": "^26.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.12",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@tailwindcss/postcss": "^4.3.4",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "@types/terser-webpack-plugin": "^5.2.0",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.6.2",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^6.0.1",
    "concurrently": "^10.0.6",
    "core-js": "^3.51.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "detect-port": "^2.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-devtools-installer": "^4.0.0",
    "electronmon": "^2.0.4",
    "eslint": "^10.14.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-erb": "^4.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-import-resolver-webpack": "^0.13.11",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-check-updates": "^23.1.1",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.10",
    "react-refresh": "^0.19.0",
    "react-test-renderer": "^19.3.1",
    "rimraf": "^6.1.4",
    "sass": "^1.107.1",
    "sass-loader": "^17.1.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "4.3.4",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.1",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1"
  },
  "build": {
    "productName": "LibreLinkUpDesktop",
    "appId": "rocks.poopjournal.librelinkupdesktop",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "afterSign": ".erb/scripts/notarize.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "snap",
        "deb"
      ],
      "icon": "assets/icon.icns",
      "synopsis": "Fetches your blood sugar from LibreLinkUp",
      "description": "This is a desktop application that fetches your blood sugar from LibreLinkUp. Developed by Crazy Marvin & Contributors, especially Yuran.",
      "category": "Utility",
      "mimeTypes": [
        "application/x-librelinkup"
      ],
      "desktop": {
        "Name": "LibreLinkUpDesktop",
        "Comment": "Fetches your blood sugar from LibreLinkUp"
      },
      "executableArgs": []
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.AppImage"
    },
    "snap": {
      "confinement": "strict",
      "grade": "stable",
      "artifactName": "${productName}-${version}-${arch}.snap"
    },
    "deb": {
      "artifactName": "${productName}-${version}-${arch}.deb"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.exe",
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LibreLinkUpDesktop"
    },
    "msi": {
      "artifactName": "${productName}-${version}-${arch}.msi",
      "shortcutName": "LibreLinkUpDesktop"
    },
    "appx": {
      "backgroundColor": "#000000",
      "displayName": "LibreLinkUpDesktop",
      "applicationId": "LibreLinkUpDesktop",
      "identityName": "6735CrazyMarvin.LibreLinkUpDesktop",
      "publisher": "CN=67460285-3F8A-4830-A61B-BAB7004F1172",
      "publisherDisplayName": "Crazy Marvin",
      "artifactName": "${productName}-${version}-${arch}.appx"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "LibreLinkUpDesktop",
      "repo": "LibreLinkUpDesktop"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser": "$@typescript-eslint/parser"
  },
  "electronmon": {
    "patterns": [
      "!**/**",
      "src/main/**"
    ],
    "logLevel": "quiet"
  }
}
